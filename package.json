{
  "name": "edgewarn-backend",
  "version": "3.0.0",
  "description": "Node.js backend server for EdgeWARN",
  "main": "src/api/server.js",
  "type": "module",
  "scripts": {
    "api": "node src/api/server.js",
    "debug:api": "node src/api/server.js --debug-server",
    "api:edgewarn": "node src/api/server.js --compat=edgewarn",
    "debug:edgewarn": "node src/api/server.js --debug-server --compat=edgewarn",
    "api:ewmrs": "node src/api/server.js --compat=ewmrs",
    "debug:ewmrs": "node src/api/server.js --debug-server --compat=ewmrs",
    "validate-config": "node scripts/validate-config.js",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "sbom:prod": "npm sbom --sbom-format cyclonedx --omit=dev --package-lock-only",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "js-yaml": "^4.1.0",
    "lru-cache": "^11.2.4",
    "morgan": "^1.10.1"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  }
}
