{
  "documents": {
    "api": {
      "schema_version": 1,
      "server": {
        "host": "0.0.0.0",
        "port": 5000,
        "debug_port": 3001,
        "request_timeout_ms": 30000,
        "service_stale_after_seconds": 30,
        "service_progress_stale_after_seconds": 600,
        "enabled_services": [
          "ingest",
          "edgewarn",
          "nexrad"
        ],
        "openapi_spec": "<src_dir>/api/openapi/v3.yaml",
        "production_version_label": "2.x",
        "v3_api_version": "3.1.0"
      },
      "security": {
        "hsts_max_age_seconds": 31536000,
        "allowed_origins": [
          "*"
        ],
        "trust_proxy": false,
        "cors": {
          "methods": [
            "GET",
            "HEAD",
            "OPTIONS"
          ],
          "allowed_headers": [
            "Content-Type",
            "X-Request-Id"
          ],
          "max_age": 600,
          "credentials": false
        },
        "csp_default_src": "'self'",
        "compression_skip_media": "image/*"
      },
      "logging": {
        "access_log_enabled": true
      },
      "rate_limits": {
        "per_second": {
          "max": 100,
          "window_ms": 1000
        },
        "per_minute": {
          "max": 6000,
          "window_ms": 60000
        },
        "standard_headers": true,
        "legacy_headers": false
      },
      "artifacts": {
        "size_limits_bytes": {
          "json": 8388608,
          "binary": 134217728,
          "image": 33554432
        },
        "json_cache": {
          "max_entries": 256,
          "max_size_bytes": 33554432
        },
        "list_limit": 1000
      },
      "pagination": {
        "default_limit": 100,
        "max_limit": 1000
      },
      "cache_control_max_age": {
        "collection": 5,
        "resource": 60,
        "asset": 31536000
      },
      "query": {
        "allowed_params": [
          "cursor",
          "limit"
        ],
        "max_value_length": 256,
        "limit_pattern": "^(?:[1-9][0-9]{0,2}|1000)$"
      },
      "validation": {
        "radar_products": [
          "DBZH",
          "VRADH",
          "WRADH",
          "PHIDP",
          "CCORH",
          "RHOHV",
          "ZDR"
        ]
      }
    },
    "api_index": {
      "api_index": {
        "inactive_cell_max_age_minutes": 120,
        "initialize_at_startup": {
          "historical": false,
          "realtime": true
        },
        "remove_old_cells": {
          "historical": false,
          "realtime": true
        },
        "stormprob_inactive_cell_max_age_minutes": 20
      },
      "schema_version": 1
    },
    "detection": {
      "alert_matching": {
        "events": [
          "Tornado Warning",
          "Severe Thunderstorm Warning",
          "Tornado Watch",
          "Severe Thunderstorm Watch",
          "Special Weather Statement",
          "Severe Weather Statement",
          "Flash Flood Warning"
        ],
        "geometry_cache_max_entries": 512,
        "point_match_buffer_deg": 0.01,
        "polygon_match_buffer_deg": 0.005,
        "snapshot_cache_max_entries": 8,
        "snapshot_max_age_seconds": 600
      },
      "detection": {
        "dataset_load_max_workers": 3,
        "drop_offset": 10.0,
        "fallback_dt_seconds": 120.0,
        "min_seed_percentage": 0.001,
        "refl_threshold": 37.5,
        "stormcell_cleanup_max_age_minutes": 120,
        "tracking_disabled_defaults": {
          "event_type": "active",
          "prediction_count": 0,
          "tracking_mode": "active"
        }
      },
      "gatemapper": {
        "baseline_refl_floor": 37.5,
        "contour_downsample": 8,
        "contour_downsample_adaptive": {
          "coarse_below_points": 24,
          "coarse_step": 4,
          "keep_all_below_points": 8,
          "keep_all_step": 1
        },
        "contour_level": 0.5,
        "coordinate_decimals": 3,
        "crop_pad_px": 2,
        "dynamic_min_threshold": {
          "high": 40.0,
          "low": 37.5,
          "switch_max_refl": 45.0
        },
        "max_refl_clamp": 52.0,
        "reject_clusters_at_or_below_gates": 5
      },
      "hail": {
        "contour_level": 0.5,
        "contour_sampling_step": 5,
        "preciptype_class": 6
      },
      "morphology": {
        "min_contour_points_for_defects": 10,
        "min_pixels_full_analysis": 25
      },
      "save": {
        "centroid_decimals": 3,
        "polygon_decimals": 3
      },
      "schema_version": 1,
      "tracker": {
        "decay_confidence_factor": 0.85,
        "decay_confidence_floor": 0.3,
        "decay_max_refl_dbz": 30.0
      }
    },
    "filesystem": {
      "base_dir": {
        "posix": "~/EdgeWARN_input",
        "windows": "C:\\\\EdgeWARN_input"
      },
      "cleanup_defaults": {
        "max_age_minutes": 60,
        "max_files": 10
      },
      "schema_version": 1
    },
    "historical": {
      "historical": {
        "cleanup_max_files": 5,
        "lat": [
          20,
          55
        ],
        "lon": [
          -130,
          -60
        ],
        "step_minutes": 1,
        "throttle_seconds": 1
      },
      "schema_version": 1
    },
    "ingest": {
      "goes": {
        "bucket": "noaa-goes19",
        "bucket_path_pattern": "{product}/{YYYY}/{DDD}/{HH}/",
        "cleanup_max_age_minutes": 60,
        "glm_outdir": "GOES_GLM_DIR",
        "glm_product": "GLM-L2-LCFA",
        "hour_lookback": 3,
        "max_entries": 96,
        "max_files_per_spec": 2
      },
      "mrms": {
        "cleanup_max_age_minutes": 60,
        "decompress_chunk_size_bytes": 1048576,
        "downloads": {
          "max_concurrency": 8,
          "optional_timeout_seconds": 30
        },
        "ncep_https": {
          "download_chunk_size_bytes": 8192,
          "match_window_seconds": 120,
          "sync_timeout_seconds": 10
        },
        "products": [
          "MRMS_EchoTop_18_00.50",
          "MRMS_EchoTop_30_00.50",
          "MRMS_EchoTop_50_00.50",
          "MRMS_RadarQualityIndex_00.00",
          "MRMS_MESH_00.50",
          "MRMS_NLDN_CG_001min_AvgDensity_00.00",
          "MRMS_PrecipRate_00.00",
          "MRMS_RadarOnly_QPE_01H_00.00",
          "MRMS_MergedAzShear_0-2kmAGL_00.50",
          "MRMS_MergedAzShear_3-6kmAGL_00.50",
          "MRMS_VIL_Density_00.50",
          "MRMS_MergedRhoHV_00.50",
          "MRMS_MergedReflectivityAtLowestAltitude_00.50",
          "MRMS_VII_00.50",
          "MRMS_VIL_00.50",
          "MRMS_Reflectivity_0C_00.50",
          "MRMS_Reflectivity_-5C_00.50",
          "MRMS_Reflectivity_-15C_00.50"
        ],
        "remove_old_files": true
      },
      "schema_version": 2
    },
    "integration": {
      "glm": {
        "bin_size_degrees": 1.0
      },
      "output": {
        "decimals": 2
      },
      "probsevere_field_map": {
        "AccumFCD": "AccumFCD",
        "CAPE_M10M30": "CAPE_M10M30",
        "CompRef": "COMPREF",
        "DCAPE": "DCAPE",
        "EBShear": "EBSHEAR",
        "EchoTop50": "EchoTop_50",
        "FlashDensity": "FLASH_DENSITY",
        "FlashRate": "FLASH_RATE",
        "H50_Above_0C": "H50_Above_0C",
        "ICP": "ICP",
        "LCL": "LCL",
        "LJA": "LJA",
        "LLLR": "LLLR",
        "MESH": "MESH",
        "MLCAPE": "MLCAPE",
        "MLCIN": "MLCIN",
        "MLLR": "MLLR",
        "MUCAPE": "MUCAPE",
        "MaxFCD": "MaxFCD",
        "MaxFED": "MaxFED",
        "MaxLLAz": "MAXLLAZ",
        "MaxRC_Emiss": "MAXRC_EMISS",
        "MeanWind_1-3kmAGL": "MEANWIND_1-3kmAGL",
        "MinFlashArea": "MinFlashArea",
        "PWAT": "PWAT",
        "ProbHail": "ProbHail",
        "ProbSevere": "ProbSevere",
        "ProbTor": "ProbTor",
        "ProbWind": "ProbWind",
        "Ref10": "REF10",
        "Ref20": "REF20",
        "SRH01km": "SRH01KM",
        "SRH02km": "SRW02KM",
        "SRW46km": "SRW46KM",
        "TE@MaxFCD": "TE@MaxFCD",
        "VIL": "VIL",
        "Wetbulb_0C_Hgt": "WETBULB_0C_HGT",
        "avg_beam_hgt": "AVG_BEAM_HGT",
        "p98LLAz": "P98LLAZ",
        "p98MLAz": "P98MLAZ"
      },
      "rap_products": {
        "derived": [
          {
            "formula": "temp_2m - dewpoint_2m",
            "key": "dewpoint_depression"
          },
          {
