          0.5,
          0.9,
          1.3,
          1.8,
          2.4,
          3.1,
          4.0
        ],
        "min_required_volume_chunks": 25,
        "waveforms": {
          "surveillance": "contiguous_surveillance",
          "doppler": "contiguous_doppler",
          "single_elevation": [
            "staggered_pulse_pair",
            "batch"
          ]
        }
      },
      "timeouts": {
        "volume_discovery_seconds": 20.0,
        "chunk_list_seconds": 20.0,
        "ingest_seconds": 120.0,
        "scan_seconds": 180.0,
        "cancellation_grace_seconds": 2.0,
        "heartbeat_stale_seconds": 240.0,
        "heartbeat_startup_grace_seconds": 60.0
      },
      "concurrency": {
        "max_site_tasks": 24,
        "max_chunk_downloads": 64,
        "worker_pool_size": 4,
        "worker_recycle_interval": 24,
        "worker_timeout_seconds": 40.0,
        "parse_checkpoint_chunk_interval": 8,
        "in_volume_prefetch": 4
      },
      "realtime": {
        "scan_interval_seconds": 20,
        "completion_interval_seconds": 10,
        "max_candidate_volumes_per_site": 3
      },
      "cli": {
        "sites": null,
        "base_dir": null
      },
      "retention": {
        "scan_dirs_to_keep": 3,
        "elevation_dirs_to_keep": 2,
        "stale_manifest_max_age_hours": 12
      },
      "gui": {
        "retention_minutes": 120,
        "poll_interval_seconds": 30.0,
        "poll_interval_min_seconds": 1.0,
        "max_workers": 8,
        "cleanup_max_age_minutes": 120
      },
      "variable_colormaps": {
        "DBZH": "NWS_Reflectivity",
        "VRADH": "VRADH",
        "WRADH": "WRADH",
        "PHIDP": "PHIDP",
        "RHOHV": "RHOHV",
        "ZDR": "ZDR"
      }
    },
    "runtime": {
      "schema_version": 1,
      "logging": {
        "retention_files": 32,
