              "wind_u"
            ]
          },
          {
            "filter": {
              "typeOfLevel": "isobaricInhPa"
            },
            "key_template": "wind_field.v{level}",
            "levels": [
              1000,
              975,
              950,
              925,
              900,
              875,
              850,
              825,
              800,
              775,
              750,
              725,
