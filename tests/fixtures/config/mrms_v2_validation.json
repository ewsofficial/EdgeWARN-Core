    "kalman": {
      "assignment": {
        "gating_threshold": 6.0,
        "method": "greedy",
        "min_gating_radius_km": 2.0,
        "prefilter_radius_km": 16.0,
        "weights": {
          "position": 1.0,
          "size_similarity": 0.5,
          "velocity_direction": 2.0
        }
      },
      "assignment_costs": {
        "default_dt_seconds": 120.0,
        "implied_speed_deadband_ms": 0.5,
        "predicted_speed_deadband_ms": 1.0,
        "reflectivity_diff_cap": 1.0,
        "size_cost_cap": 1.0,
        "size_ratio_log2_divisor": 2.0
      },
      "confidence": {
        "factor_floor": 0.8,
        "motion_factor_variance_denominator": 2500.0,
        "position_decay_onset_std": 5.0,
        "position_decay_scale": 30.0,
        "time_penalty_weight": 0.3
      },
      "filter_internals": {
        "initial_acceleration_variance": 1.0,
        "initial_position_uncertainty_km": 1.0,
        "initial_velocity_variance": 100.0,
        "innovation_covariance_regularization": 1e-06,
        "singular_retry_regularization": 0.0001
      },
      "kalman_filter": {
        "measurement_noise": {
          "position": 0.5
        },
        "process_noise": {
          "acceleration": 0.1
        }
      },
      "schema_version": 1,
      "tracking": {
        "confidence_decay_factor": 0.7,
        "confidence_threshold": 0.4,
        "max_prediction_time_minutes": 6.0
      }
    },
    "lineage": {
      "lineage": {
        "bounds_prefilter_buffer_deg": 0.0,
        "buffer": {
          "max_pending": 100,
          "min_confirmations": 2,
          "prune_after_scans": 5,
          "scan_interval_seconds": 120.0
        },
        "tracked_overlap_ratio": 0.1
      },
      "schema_version": 1
    },
    "nexrad": {
      "schema_version": 1,
      "buckets": {
        "chunks": "unidata-nexrad-level2-chunks"
      },
      "stations": {
        "catalog_url": "https://api.weather.gov/radar/stations",
        "api_timeout_seconds": 15,
        "api_cache_ttl_seconds": 30
      },
      "selection": {
        "allowed_vcps": [
          12,
          212,
          215
        ],
