            "var": "v",
            "var_aliases": [
              "v",
              "VGRD",
              "v-component_of_wind_isobaric",
              "wind_v"
            ]
          },
          {
            "filter": {
              "level": 10,
              "typeOfLevel": "heightAboveGround"
            },
            "key": "u10m",
            "var": "u10",
            "var_aliases": [
              "u10",
              "10u",
              "u"
            ]
          },
          {
            "filter": {
              "level": 10,
              "typeOfLevel": "heightAboveGround"
            },
            "key": "v10m",
            "var": "v10",
            "var_aliases": [
              "v10",
              "10v",
              "v"
            ]
          },
          {
            "filter": {
              "level": 2,
              "typeOfLevel": "heightAboveGround"
            },
            "key": "temp_2m",
            "transform": "kelvin_to_celsius",
            "var": "t2m",
            "var_aliases": [
              "t2m",
              "2t",
              "t"
            ]
          },
          {
            "filter": {
              "level": 2,
              "typeOfLevel": "heightAboveGround"
            },
            "key": "dewpoint_2m",
            "transform": "kelvin_to_celsius",
            "var": "d2m",
            "var_aliases": [
              "d2m",
              "2d",
              "dpt"
            ]
          },
          {
            "filter": {
              "typeOfLevel": "isothermZero"
            },
            "key": "freezing_level_m",
            "var": "gh"
          }
        ]
      },
      "schema_version": 1,
      "stats_datasets": [
