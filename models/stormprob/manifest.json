  "inference_math": {
    "motion_displacement_km": "(initial_wind_mps + residual_motion_mps) * lead_seconds / 1000",
    "initial_wind": "mean 0-6km wind from paired wind_field u/v levels (standard atmosphere)",
    "shape": "sample 20 joint members (seed 42): each member gets an independent Fourier shape draw and an independent centroid draw; member centre = base + offset_km + L @ z where base is the frozen-motion displacement (initial_wind + residual) * lead_seconds / 1000, offset_km the learned km correction from the radial graph, and L the per-lead Cholesky factor; add the tanh-bounded (30 km) residual to the current 64-ray profile; occupancy-rasterize each member about its own centre; probability is the raw member fraction k/20; the 0.25 contour is polygonized",
    "primary_output": "four separate valid-time polygons (15/30/45/60); swept envelopes are separate products"
  },
