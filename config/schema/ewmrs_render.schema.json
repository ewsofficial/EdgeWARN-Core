{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ewmrs_render.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tiles", "chunk_format", "mrms_layers", "goes_layers", "goes_transform", "nexrad_gui"],
  "properties": {
    "schema_version": { "const": 1 },
    "tiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tile_size"],
      "properties": {
        "tile_size": { "type": "integer", "exclusiveMinimum": 0 }
      }
    },
    "chunk_format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wire_version", "format_version", "encoding", "data_type", "channels", "value_kind", "no_data", "file_suffix", "compression", "media_type", "bytes_per_component", "pixel_row_order", "grid_origin"],
      "properties": {
        "wire_version": { "type": "integer" },
        "format_version": { "type": "integer" },
        "encoding": { "type": "string" },
        "data_type": { "type": "string" },
        "channels": { "type": "integer", "minimum": 1 },
        "value_kind": { "type": "string" },
        "no_data": { "type": "string" },
        "file_suffix": { "type": "string" },
        "compression": { "type": "string" },
        "media_type": { "type": "string" },
        "bytes_per_component": { "type": "integer", "minimum": 1 },
        "pixel_row_order": { "type": "string" },
        "grid_origin": { "type": "string" }
      }
    },
    "mrms_layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "colormap_key", "outdir"],
        "properties": {
          "name": { "type": "string" },
          "colormap_key": { "type": "string" },
          "product": { "type": "string" },
          "filepath": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "outdir": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "required": { "type": "boolean" }
        }
      }
    },
    "goes_layers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["common", "layers"],
      "properties": {
        "common": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_type", "variable_name", "fallback_variable_names"],
          "properties": {
            "source_type": { "type": "string" },
            "variable_name": { "type": "string" },
            "fallback_variable_names": { "type": "array", "items": { "type": "string" } },
            "required": { "type": "boolean" }
          }
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "channel_id", "colormap_key", "value_transform", "filepath", "outdir", "mask_min", "mask_max"],
            "properties": {
              "name": { "type": "string" },
              "channel_id": { "type": "string", "pattern": "^C[0-9]{2}$" },
              "colormap_key": { "type": "string" },
              "value_transform": { "enum": ["reflectance_from_rad", "brightness_temp_from_rad"] },
              "filepath": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
              "outdir": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
              "mask_min": {
                "type": "object",
                "additionalProperties": { "type": "number" }
              },
              "mask_max": {
                "type": "object",
                "additionalProperties": { "type": "number" }
              }
            }
          }
        }
      }
    },
    "goes_transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resampling"],
      "properties": {
        "resampling": {
          "type": "string",
          "enum": ["nearest", "bilinear", "cubic", "cubic_spline", "lanczos", "average", "mode", "max", "min", "med", "q1", "q3", "sum", "rms"]
        }
      }
    },
    "nexrad_gui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variable_colormaps"],
      "properties": {
        "variable_colormaps": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}
