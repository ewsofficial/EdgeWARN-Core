{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ewmrs_pipeline.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "render", "nexrad_gui", "workers", "render_threads", "caches", "rap_uint16"],
  "properties": {
    "schema_version": { "const": 1 },
    "rap_uint16": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_timestamps", "timestamp_format", "force", "uint16", "layers", "templates"],
      "properties": {
        "max_timestamps": {"type": "integer", "minimum": 1},
        "timestamp_format": {"type": "string"},
        "force": {"type": "boolean"},
        "uint16": {"type": "object", "additionalProperties": false, "required": ["nodata", "valid_max"], "properties": {"nodata": {"type": "integer", "minimum": 0, "maximum": 65535}, "valid_max": {"type": "integer", "minimum": 0, "maximum": 65535}}},
        "layers": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "short_names", "filter", "units", "scale", "outdir", "description"], "properties": {"name": {"type": "string"}, "short_names": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "filter": {"type": "object", "additionalProperties": false, "required": ["typeOfLevel", "level"], "properties": {"typeOfLevel": {"type": "string"}, "level": {"type": ["integer", "string"]}}}, "units": {"type": "string"}, "scale": {"type": "object", "additionalProperties": false, "required": ["min", "max"], "properties": {"min": {"type": "number"}, "max": {"type": "number"}}}, "outdir": {"type": "string"}, "description": {"type": "string"}, "colormap_key": {"type": "string"}}}},
        "templates": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["values", "layers"], "properties": {"values": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": {"type": ["integer", "string"]}}}, "layers": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "short_names", "filter", "units", "scale", "outdir", "description"], "properties": {"name": {"type": "string"}, "short_names": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "filter": {"type": "object", "additionalProperties": false, "required": ["typeOfLevel", "level"], "properties": {"typeOfLevel": {"type": "string"}, "level": {"type": ["integer", "string"]}}}, "units": {"type": "string"}, "scale": {"type": "object", "additionalProperties": false, "required": ["min", "max"], "properties": {"min": {"type": "number"}, "max": {"type": "number"}}}, "outdir": {"type": "string"}, "description": {"type": "string"}, "colormap_key": {"type": "string"}}}}}}}
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cleanup_after", "phase_name", "goes_cleanup_max_age_minutes", "goes_cleanup_min_interval_seconds", "gui_cleanup_max_age_minutes"],
      "properties": {
        "cleanup_after": { "type": "boolean" },
        "phase_name": { "type": "string" },
        "goes_cleanup_max_age_minutes": { "type": "integer", "minimum": 1 },
        "goes_cleanup_min_interval_seconds": { "type": "number", "minimum": 0 },
        "gui_cleanup_max_age_minutes": { "type": "integer", "minimum": 1 }
      }
    },
    "nexrad_gui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retention_minutes", "poll_interval_seconds", "poll_interval_min_seconds", "max_workers"],
      "properties": {
        "retention_minutes": { "type": "integer", "minimum": 1 },
        "poll_interval_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "poll_interval_min_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "max_workers": { "type": "integer", "minimum": 1 }
      }
    },
    "workers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_workers", "worker_memory_cap", "psutil_fallback_max", "numeric_thread_caps"],
      "properties": {
        "max_workers": { "type": "integer", "minimum": 1 },
        "worker_memory_cap": { "type": "number", "exclusiveMinimum": 0 },
        "psutil_fallback_max": { "type": "integer", "minimum": 1 },
        "numeric_thread_caps": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "variables"],
          "properties": {
            "value": { "type": "integer", "minimum": 1 },
            "variables": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
            }
          }
        }
      }
    },
    "render_threads": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_tile_threads"],
      "properties": {
        "max_tile_threads": { "type": "integer", "minimum": 1 }
      }
    },
    "caches": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tile_index_entries"],
      "properties": {
        "tile_index_entries": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
